{
  "name": "ocrdiffalign-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"uv run --project .. uvicorn ocrdiffalign.app:app --reload --port 8000\" \"vite --port 5173 --strictPort\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:api": "uv run --project .. uvicorn ocrdiffalign.app:app --reload --port 8000",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --jsconfig ./jsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "concurrently": "^9.2.1",
    "svelte": "^5.46.0",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
